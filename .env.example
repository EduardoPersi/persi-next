WORDPRESS_URL=https://persimateriais.com.br
WORDPRESS_STOCK_NOTIFICATION_ENDPOINT=https://persimateriais.com.br/wp-json/persi/v1/stock-notifications/subscribe
PERSI_HEADLESS_STOCK_HMAC_SECRET=
PERSI_HEADLESS_STOCK_HMAC_KEY_ID=primary
PERSI_HEADLESS_STOCK_ORIGIN=https://app.persimateriais.com.br
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
PERSI_HEADLESS_CHECKOUT_HMAC_SECRET=
PERSI_HEADLESS_CHECKOUT_HMAC_KEY_ID=
PERSI_HEADLESS_CHECKOUT_ORIGIN=https://app.persimateriais.com.br
PERSI_HEADLESS_CHECKOUT_ENDPOINT=
PERSI_HEADLESS_ACCOUNT_HMAC_SECRET=
PERSI_HEADLESS_ACCOUNT_HMAC_KEY_ID=primary
PERSI_HEADLESS_ACCOUNT_ORIGIN=https://app.persimateriais.com.br
PERSI_HEADLESS_ACCOUNT_ENDPOINT=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Origem pública onde este app Next.js está hospedado — usada para montar
# URLs de callback/webhook enviadas aos provedores de pagamento (Inter,
# PagBank). Hoje aponta para o domínio de teste; trocar para
# https://persimateriais.com.br quando o domínio definitivo entrar no ar (e
# recadastrar/re-registrar os webhooks — ver scripts/register-inter-webhooks.mjs).
APP_BASE_URL=https://app.persimateriais.com.br

# Banco Inter — OAuth2 client_credentials + mTLS (Pix e boleto)
INTER_API_BASE_URL=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_BASE64=
INTER_PRIVATE_KEY_BASE64=
INTER_PIX_KEY=

# PagBank — cartão de crédito/débito, Apple Pay, Google Pay
PAGBANK_API_BASE_URL=
PAGBANK_CLIENT_SECRET=
NEXT_PUBLIC_PAGBANK_PUBLIC_KEY=

# Segredo compartilhado para autenticar o cron externo que expira pedidos
# Pix/boleto pendentes vencidos (ver app/api/cron/expire-pending-payments).
# Configurar o mesmo valor na tarefa agendada da Hostinger (header
# Authorization: Bearer <valor>).
CRON_SECRET=

# NextAuth (Auth.js) — gerar com `npx auth secret`
AUTH_SECRET=

# Login legado (Google/Facebook) — mantido até a migração para NextAuth ser
# validada em produção (ver Fase F do plano de migração). Callback antigo:
# /api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.persimateriais.com.br/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://app.persimateriais.com.br/api/auth/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v23.0

# NextAuth usa as mesmas credenciais acima (GOOGLE_CLIENT_ID/SECRET,
# FACEBOOK_CLIENT_ID/SECRET, FACEBOOK_GRAPH_API_VERSION). O novo callback
# URL a cadastrar no console do Google/Facebook é:
# /api/auth/callback/google e /api/auth/callback/facebook
