WORDPRESS_URL=https://loja.persimateriais.com.br
CHECKOUT_MODE=next
CHECKOUT_PIX_ENABLED=true
CHECKOUT_BOLETO_ENABLED=true
CHECKOUT_CARD_ENABLED=false
CHECKOUT_CARD_ENVIRONMENT=sandbox
CHECKOUT_CARD_PRODUCTION_APPROVED=false
# Somente staging: permite testar concorrência até a criação do pedido, sem
# chamar o gateway. Não configurar em produção.
CHECKOUT_STAGING_DRY_RUN_SECRET=
CHECKOUT_STAGING_INSTANCE_URLS=
CHECKOUT_STAGING_COOKIE=
CHECKOUT_STAGING_PAYMENT_JSON=
WORDPRESS_STOCK_NOTIFICATION_ENDPOINT=https://loja.persimateriais.com.br/wp-json/persi/v1/stock-notifications/subscribe
PERSI_HEADLESS_STOCK_HMAC_SECRET=
PERSI_HEADLESS_STOCK_HMAC_KEY_ID=primary
PERSI_HEADLESS_STOCK_ORIGIN=https://persimateriais.com.br

# Newsletter do rodapé — mesmo padrão de segurança do aviso de estoque acima,
# segredo e origem exclusivos deste módulo (não reutilizar os de cima).
WORDPRESS_NEWSLETTER_ENDPOINT=https://loja.persimateriais.com.br/wp-json/persi/v1/newsletter/subscribe
PERSI_HEADLESS_NEWSLETTER_HMAC_SECRET=
PERSI_HEADLESS_NEWSLETTER_HMAC_KEY_ID=primary
PERSI_HEADLESS_NEWSLETTER_ORIGIN=https://persimateriais.com.br

# Formulário de contato (/contato) — mesmo padrão de segurança acima, segredo
# e origem exclusivos deste módulo. Requer o módulo "contact" do plugin
# persi-headless publicado no WordPress com o mesmo par secret/key-id.
WORDPRESS_CONTACT_ENDPOINT=https://loja.persimateriais.com.br/wp-json/persi/v1/contact/submit
PERSI_HEADLESS_CONTACT_HMAC_SECRET=
PERSI_HEADLESS_CONTACT_HMAC_KEY_ID=primary
PERSI_HEADLESS_CONTACT_ORIGIN=https://persimateriais.com.br

# Google Maps Embed API — mapa da loja na página /contato. Chave pública por
# natureza da Maps Embed API; restringir por domínio/referrer no Google Cloud
# Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
PERSI_HEADLESS_CHECKOUT_HMAC_SECRET=
PERSI_HEADLESS_CHECKOUT_HMAC_KEY_ID=
PERSI_HEADLESS_CHECKOUT_ORIGIN=https://persimateriais.com.br
PERSI_HEADLESS_CHECKOUT_ENDPOINT=https://loja.persimateriais.com.br/wp-json/persi-headless/v1/checkout-transfer
PERSI_HEADLESS_CHECKOUT_ATTEMPT_ENDPOINT=https://loja.persimateriais.com.br/wp-json/persi-headless/v1/checkout-attempt
PERSI_HEADLESS_ACCOUNT_ORIGIN=https://persimateriais.com.br
PERSI_HEADLESS_CHECKOUT_AUTH_SECRET=
PERSI_HEADLESS_CHECKOUT_AUTH_KEY_ID=primary
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOO_REQUEST_DIAGNOSTICS=0

# Origem pública onde este app Next.js está hospedado — usada para montar
# URLs de callback/webhook enviadas aos provedores de pagamento (Inter,
# PagBank). Ao trocar este valor, recadastrar/re-registrar os webhooks — ver
# scripts/register-inter-webhooks.mjs.
APP_BASE_URL=https://persimateriais.com.br

# Banco Inter — OAuth2 client_credentials + mTLS (Pix e boleto)
INTER_API_BASE_URL=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICATE_BASE64=
INTER_PRIVATE_KEY_BASE64=
INTER_PIX_KEY=

# PagBank — cartão de crédito/débito, Apple Pay, Google Pay
PAGBANK_API_BASE_URL=
PAGBANK_CLIENT_SECRET=
NEXT_PUBLIC_PAGBANK_PUBLIC_KEY=

# Segredo compartilhado para autenticar o cron externo que expira pedidos
# Pix/boleto pendentes vencidos (ver app/api/cron/expire-pending-payments).
# Configurar o mesmo valor na tarefa agendada da Hostinger (header
# Authorization: Bearer <valor>).
CRON_SECRET=

# OAuth social validado no Next.js e novamente pelo WordPress antes da emissão JWT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://persimateriais.com.br/api/auth/google/callback
# Mesmo valor de GOOGLE_CLIENT_ID, exposto ao navegador para o script do
# Google Identity Services (One Tap). Requer o domínio em "Authorized
# JavaScript origins" no Google Cloud Console (separado do redirect URI acima).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://persimateriais.com.br/api/auth/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v23.0

# Container do Google Tag Manager (Meta Pixel e tag do Google configurados
# dentro do próprio container). Exposto ao navegador pois o snippet do GTM
# roda no client, com Consent Mode v2 integrado ao banner de cookies.
NEXT_PUBLIC_GTM_ID=

# reCAPTCHA v3 — proteção antibot em newsletter, aviso de estoque, criar
# conta, esqueci/redefinir senha e login. RECAPTCHA_SECRET_KEY nunca é
# exposta ao navegador (fica só no servidor); a site key é pública por
# natureza do reCAPTCHA. Sem estas variáveis, a verificação fica
# desativada (formulários seguem funcionando, só sem a proteção extra).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score abaixo de LOW é bloqueado; entre LOW e HIGH é aceito e registrado
# para calibração; acima de HIGH é aceito normalmente. Ajustar com base
# nos logs "[recaptcha]" depois de alguns dias em produção.
RECAPTCHA_SCORE_LOW=0.3
RECAPTCHA_SCORE_HIGH=0.5
