{
  "name": "persi-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset:local": "supabase db reset --local",
    "db:test": "supabase test db && npm run db:validate:local && node scripts/database/price-history-validation.mjs --local && node scripts/database/inventory-concurrency.mjs --local",
    "db:validate:local": "node --experimental-loader ./scripts/database/typescript-loader.mjs scripts/database/phase-c-validation.mjs --local",
    "test:jwt": "npx --yes tsx scripts/test-jwt.ts",
    "test:cart:hostinger": "node tests/cart-hostinger-smoke.mjs",
    "test:cart:isolation": "node tests/cart-isolation.mjs",
    "test:cart:isolation:direct": "node tests/cart-isolation.mjs",
    "test:cart:isolation:hostinger": "node tests/cart-isolation.mjs",
    "test:checkout:shipping": "node tests/checkout-shipping-smoke.mjs",
    "test:checkout:load": "node scripts/checkout-load-smoke.mjs",
    "test:checkout:staging-concurrency": "node scripts/checkout-staging-concurrency.mjs",
    "test:checkout:staging-health": "node scripts/checkout-attempt-health.mjs",
    "audit:urls": "node --env-file=.env.local scripts/audit-public-slugs.mjs",
    "register:inter-webhooks": "node --env-file=.env.local scripts/register-inter-webhooks.mjs",
    "generate:pagbank-public-key": "node --env-file=.env.local scripts/generate-pagbank-public-key.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.1",
    "postcss": "^8.5.26",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "swiper": "^14.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch@3.1.5": "10.2.5"
  }
}
